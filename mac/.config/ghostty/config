# =============================================================================
# Ghostty config — macOS
# =============================================================================

# Shell
shell-integration = zsh

# Theme
theme = nord

# Font — install via: brew install --cask font-jetbrains-mono-nerd-font
# Falls back to system monospace if not found
font-family = JetBrains Mono
font-size = 13

# Window
window-padding-x = 10
window-padding-y = 10

# Quick terminal (global hotkey — works even when Ghostty isn't focused)
keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.1

# Mouse
mouse-hide-while-typing = true

# Cursor
cursor-style = block
cursor-style-blink = true

# Scrollback
scrollback-limit = 10000

# Copy on select
copy-on-select = true

# Don't confirm on quit if there's only one window
confirm-close-surface = false
