{
  "permissions": {
    "allow": [
      "Bash(systemctl --user daemon-reload)",
      "Bash(systemctl --user start rclone-gdrive.service rclone-onedrive.service)",
      "Bash(journalctl --user -u nautilus --since '1 hour ago' -n 50)",
      "Bash(journalctl --user -n 50 --since '1 hour ago')",
      "Bash(omarchy-version)",
      "Read(//mnt/gdrive/**)",
      "Read(//mnt/onedrive/**)",
      "Bash(adb shell:*)",
      "Bash(adb pull:*)",
      "Bash(omarchy-restart-hypridle:*)"
    ],
    "defaultMode": "default"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "andrej-karpathy-skills@karpathy-skills": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    }
  },
  "effortLevel": "medium",
  "awaySummaryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim",
  "skipAutoPermissionPrompt": true
}
